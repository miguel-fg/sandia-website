---
import type { CollectionEntry } from 'astro:content';
import '../styles/global.css'

type Props = {
  book: CollectionEntry<'books'>
}

const { book } = Astro.props
---

<div class="flex flex-col gap-2 py-10 items-end">
  <div class="flex justify-between items-center w-full">
    <div class="flex gap-2 items-center">
      <strong class="text-3xl uppercase">{book.data.title}</strong>
      <span class="text-lg italic font-light">{book.data.author}</span>
    </div>
    <span class="font-medium text-teal-700 text-2xl">{book.data.rating}<span class="font-light text-slate-800 text-base">/10</span></span>
  </div>
  <p class="text-md w-full">{book.data.summary}</p>
  <a class="text-lg text-slate-700 font-semibold hover:text-slate-800" href={`/books/${book.id}`}>Read Review</a>
</div>
