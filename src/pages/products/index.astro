---
export const prerender = false
import BaseLayout from "../../layouts/BaseLayout.astro";

type Product = {
  title: string
}

const response = await fetch('https://dummyjson.com/products')
const json = await response.json()
const products: Product[] = json.products
---

<BaseLayout>
  {products.map((p) => (
    <div>{p.title}</div>
  ))}
</BaseLayout>
